        ]}
      ]
    },

    {
      "id": "summary", "type": "doc", "title": "把方程式写全", "progress": 90,
      "cols": [
        { "title": "第一支", "lines": [
          "CuSO₄ + 2NaOH = Na₂SO₄ + Cu(OH)₂↓",
