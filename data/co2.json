  "scoreItems": [
    { "key": "equip",     "name": "器材选择",         "max": 10, "dim": "skill" },
    { "key": "assemble",  "name": "放置发生装置",     "max": 10, "dim": "skill" },
    { "key": "load",      "name": "装入大理石",       "max": 8,  "dim": "skill" },
    { "key": "install",   "name": "安装双孔塞与漏斗", "max": 12, "dim": "skill" },
    { "key": "acid",      "name": "加入稀盐酸",       "max": 8,  "dim": "skill" },
    { "key": "seal",      "name": "长颈漏斗液封",     "max": 12, "dim": "safety" },
    { "key": "collect",   "name": "向上排空气法收集", "max": 12, "dim": "skill" },
    { "key": "fullcheck", "name": "验满操作",         "max": 10, "dim": "safety" },
    { "key": "takeout",   "name": "盖片正放保存",     "max": 8,  "dim": "safety" },
    { "key": "lime",      "name": "石灰水检验",       "max": 10, "dim": "skill" }
  ],

  "initialStage": {
    "flaskPlaced": false, "marble": false, "stopperOn": false, "funnelOn": false,
    "pipeOn": false, "pipeOut": false, "acid": false, "wrongPour": false,
    "gasEscape": false, "reacting": false, "gas": 0,
    "bottlePlaced": false, "glassOn": false,
    "wood": false, "woodFire": true, "woodOut": false, "lime": false
  },

