                { "do": "set", "k": "suckStage", "v": 3, "delay": 2100 },
                { "do": "set", "k": "suckStage", "v": 4, "delay": 2900 },
                { "do": "set", "k": "crackStage", "v": 1, "delay": 2900 },
                { "do": "set", "k": "crackStage", "v": 2, "delay": 3400 },
                { "do": "set", "k": "crackStage", "v": 3, "delay": 3900 },
                { "do": "tip", "text": "试管炸裂！正确顺序：先把导管移出水面，再熄灭酒精灯", "kind": "err", "delay": 4400 },
